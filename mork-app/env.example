# NOTE:
# - The app reads from mork-app/.env.local at runtime.
# - env.example is only a template used to create .env.local once.
# - If .env.local already exists, edit .env.local directly.
# - Keep real secrets only in .env.local. Never commit filled-in secrets.

# -----------------------------------------------------------------------------
# Core app/runtime
# -----------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
NODE_ENV="development"
HOST="0.0.0.0"
PORT="3000"
LOG_LEVEL="info"
# Optional app identity overrides. Core defaults are baked into src/lib/core/defaults.ts.
MORK_PRIME_DIRECTIVE=""
MORK_PERSIST_DIR=""

# -----------------------------------------------------------------------------
# Wallet + Solana RPC
# -----------------------------------------------------------------------------
MORK_WALLET=""
MORK_WALLET_SECRET_KEY=""
WALLET_PRIVATE_KEY=""
WALLET_PATH=""
MORK_SETUP_WALLET_MODE="auto"
MORK_WALLET_IMPORT_PATH=""
MORK_WALLET_TOKENS_CACHE_MS=""
# BBQ gate is fixed in code: symbol BBQ, mint B59tYSWnDNTDbTsDXvhmXghJXsyunPsXfYFr7KfXBqYn, required balance 1000.
# Optional RPC overrides; app defaults to public mainnet-beta RPC when unset.
SOLANA_RPC_URL=""
SOLANA_RPC_URLS=""
RPC_URL=""

# -----------------------------------------------------------------------------
# Ollama/local model runtime
# -----------------------------------------------------------------------------
# Optional Ollama overrides; app defaults to http://127.0.0.1:11434 and llama3.2:3b.
OLLAMA_HOST=""
OLLAMA_MODEL=""
OLLAMA_MODEL_CODING=""
OLLAMA_MODEL_TELEGRAM=""
OLLAMA_MODEL_X=""
OLLAMA_CTX=""
OLLAMA_TIMEOUT_MS=""

# -----------------------------------------------------------------------------
# mork-core routing/reporting
# -----------------------------------------------------------------------------
# Local app-first default points to mork-app API surface.
MORK_CORE_URL=""
# Container/service-network fallback used when mork-core is not on localhost.
MORK_CORE_SERVICE_FALLBACK_URL=""
MORK_CORE_PORT=""
MORK_CORE_AUTH_HEADER=""
MORK_CORE_AUTH=""
MORK_OPPORTUNITY_PATH="/market/opportunity"
MORK_BALANCES_PATH="/wallet/balances"
MORK_EXEC_PATH="/market/execution"
MORK_REPORT_COOLDOWN_MS="15000"
MORK_REPORT_MAX_BYTES="16000"
MORK_REPORT_MIN_POST_GAP_MS="250"
MORK_REPORT_FAILURE_LOG_COOLDOWN_MS="30000"
MORK_REPORT_CORE_RECHECK_MS="30000"

# -----------------------------------------------------------------------------
# App-controlled swap guardrails
# -----------------------------------------------------------------------------
# 0 = disabled (safe default), 1 = enabled (allows live swap route when other safety gates pass)
MORK_AGENT_SWAP_ENABLED="0"
MORK_AGENT_SWAP_MAX_SOL=""
# Autonomous planner dust guards: block trades whose notional/fee economics are too small.
MORK_AGENT_MIN_TRADE_USD="1"
MORK_AGENT_MIN_TRADE_SOL="0.0005"
MORK_ESTIMATED_SWAP_FEE_SOL="0.00001"
MORK_AGENT_MIN_TRADE_FEE_MULTIPLE="50"
MORK_SELL_PROFIT_THRESHOLD_PCT=""
MORK_AUTONOMOUS_TRADING_ENABLED="0"

# -----------------------------------------------------------------------------
# Jupiter routing/token APIs
# -----------------------------------------------------------------------------
# Optional Jupiter overrides; app defaults to api.jup.ag + lite-api.jup.ag.
JUP_BASE_URL=""
JUP_BASE_URLS=""
JUP_TIMEOUT_MS=""
JUP_API_KEY=""

# -----------------------------------------------------------------------------
# Helius / MEV bot connection
# Required by services/sol-mev-bot when running that service.
# -----------------------------------------------------------------------------
HELIUS_API_KEY=""
HELIUS_RPC_URL=""
HELIUS_WS_URL=""

# -----------------------------------------------------------------------------
# Trading safety defaults
# -----------------------------------------------------------------------------
# Trading stays simulated unless ARMED=true and PAPER=false.
# ARMED=false blocks live txs even if PAPER is accidentally set false.
ARMED="false"
PAPER="true"
# Legacy services may still read DRY_RUN if explicitly set; prefer ARMED/PAPER.
# DRY_RUN="true"
# BBQ wallet gate: wallet-controlled features require at least 1,000 BBQ.
# This is enforced in code to avoid accidental removal of the project gate.
MIN_SOL_FOR_FEES="0.01"
MAX_TRADES_PER_HOUR="6"
MINT_COOLDOWN_MS="0"
MAX_CONSECUTIVE_FAILS="10"
DAILY_LOSS_LIMIT_USD="5"
DAILY_PROFIT_TARGET_USD="0"
MAX_TRADE_USDC="5"
DEFAULT_PAPER_MAX_TRADE_USDC="5"
EXECUTION_BUFFER_USD="1"
MIN_NET_PROFIT_USD="0.01"
TX_COST_USD="0.002"
SCAN_BATCH_SIZE="2"
LOOP_DELAY_MS="8000"
SCAN_TIMEOUT_MS="8000"
HEARTBEAT_EVERY_LOOPS="10"
BALANCE_CHECK_EVERY_MS="600000"

# -----------------------------------------------------------------------------
# services/sol-mev-bot strategy toggles
# -----------------------------------------------------------------------------
ENABLE_ARB="false"
ENABLE_AMM_IMBALANCE="false"
ENABLE_MOMENTUM="false"
ENABLE_TRIANGULAR_ARB="false"
ENABLE_LIQUIDATION_ARB="false"
ENABLE_DRIFT_FUNDING="false"
ENABLE_STABLECOIN_DEPEG="false"
ENABLE_TRIANGULAR_ROUTES="false"
WATCH_PUMP_FUN="false"
USE_RUST_ENGINE="false"
DYNAMIC_JITO_TIP="true"

# -----------------------------------------------------------------------------
# services/sol-mev-bot strategy tuning
# -----------------------------------------------------------------------------
MIN_PROFIT_LAMPORTS="5000"
MAX_POSITION_SOL="0.5"
PRIORITY_FEE_MICROLAMPORTS="50000"
PRIORITY_FEE_LEVEL="medium"
PRIORITY_FEE_MAX_LAMPORTS="1000000"
SLIPPAGE_BPS="50"
AMM_MIN_IMBALANCE_PCT="5"
AMM_POOL_COOLDOWN_MS="300000"
ARB_TOKEN_MINTS=""
MOMENTUM_VOL_SPIKE_MULTIPLIER="5"
MOMENTUM_TRAILING_STOP_PCT="15"
CROSS_DEX_MIN_SPREAD_PCT="0.5"
DRIFT_MIN_FUNDING_RATE_PCT="0.05"
STABLECOIN_DEPEG_THRESHOLD_PCT="0.3"
LIQUIDATION_DIP_THRESHOLD_PCT="3"
LIQUIDATION_TRAILING_STOP_PCT="2"
CORRELATION_THRESHOLD="0.75"
CB_MAX_LOSS_HOUR_SOL="0.5"
CB_MAX_LOSS_SESSION_SOL="1.0"
CB_MAX_CONSECUTIVE_LOSSES="5"
CB_MAX_TRADES_PER_MIN="30"
# Required when ENABLE_MOMENTUM=true; missing key disables MomentumRunner to avoid 401 spam.
BIRDEYE_API_KEY=""

# -----------------------------------------------------------------------------
# Jito / block engine
# -----------------------------------------------------------------------------
JITO_BLOCK_ENGINE_URL="https://mainnet.block-engine.jito.wtf"
JITO_TIP_LAMPORTS="10000"

# -----------------------------------------------------------------------------
# services/arb tuning
# -----------------------------------------------------------------------------
FEE_SOL_MIN="0.03"
FEE_SOL_TARGET="0.08"
FEE_CHECK_EVERY_MS="300000"
TOPUP_SLIPPAGE_BPS="50"
CANDIDATE_WINDOW_MS="600000"
CANDIDATE_THRESHOLD="3"
WHITELIST_RESEARCH_FILE="whitelist.research.json"
WHITELIST_TARGET="1000"

# -----------------------------------------------------------------------------
# Rust MEV engine
# -----------------------------------------------------------------------------
MEV_ENGINE_PORT="8789"
MAX_ACCOUNTS="64"

# -----------------------------------------------------------------------------
# Social / channel integrations
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
FACEBOOT_AGENT_TOKEN=""
MOLTBOOK_API_KEY=""
MOLTBOOK_API_BASE=""
MOLTBOOK_KILL_SWITCH="0"
MOLTBOOK_MULTI_FACTOR_REQUIRED="1"
VOICE_REPLY_PROBABILITY="0.2"
USE_OPENAI="0"
NEXT_PUBLIC_SHERPA_GRADIO_URL=""
MORK_SETUP_SKIP_SHERPA="0"
MORK_SOCIAL_SIGNAL_WINDOW_MINUTES="60"
MORK_SOCIAL_SIGNAL_MIN_COUNT="2"
MORK_SOCIAL_SHERPA_MIN_COUNT="1"

# -----------------------------------------------------------------------------
# Media generation
# -----------------------------------------------------------------------------
MEDIA_IMAGE_MODEL="flux"
MEDIA_IMAGE_WIDTH="1024"
MEDIA_IMAGE_HEIGHT="1024"
MEDIA_IMAGE_SEED=""
# Optional comma-separated public image URLs for style/reference conditioning.
# First-time setup URL pack can also populate this automatically via /api/app/style-pack.
MEDIA_STYLE_IMAGE_URLS=""
# Optional video endpoint for free-tier providers you control.
# Leave empty to use Pollinations media endpoint by default (https://gen.pollinations.ai/image/{prompt}).
# Set this only if you want a custom endpoint that returns binary video bytes from JSON { prompt }.
MEDIA_VIDEO_ENDPOINT=""
# Used only when MEDIA_VIDEO_ENDPOINT is set (custom provider mode).
MEDIA_VIDEO_METHOD="POST"
# Optional Pollinations video model override (when MEDIA_VIDEO_ENDPOINT is empty).
# Supported: veo, seedance, seedance-pro, wan, wan-fast, grok-video-pro, ltx-2, p-video, nova-reel
MEDIA_VIDEO_MODEL=""
# Pollinations default video model when MEDIA_VIDEO_MODEL is unset/invalid.
MEDIA_VIDEO_MODEL_DEFAULT="ltx-2"
# Optional deterministic seed for Pollinations video (integer).
MEDIA_VIDEO_SEED=""
# Optional Pollinations video controls.
MEDIA_VIDEO_DURATION=""
MEDIA_VIDEO_ASPECT_RATIO=""
MEDIA_VIDEO_AUDIO=""
MEDIA_VIDEO_TOKEN=""
MEDIA_AUDIO_MODEL=""

# -----------------------------------------------------------------------------
# Meme/core compose timeouts
# -----------------------------------------------------------------------------
MEME_CORE_REFLECT_TIMEOUT_SECONDS="20"
MEME_CORE_COMPOSE_TIMEOUT_SECONDS="12"
